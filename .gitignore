# ==============================================================================
# easyRSS - .gitignore
# ==============================================================================

# 1. Kişisel Veriler, Akışlar & Gizlilik (Personal Data & Privacy)
*.opml
*.xml.backup
*.json.backup
data.json
*.data
*.sqlite
*.sqlite3
*.db
*.store
*.log
*.crash
*.ips
logs/

# Kimlik Doğrulama, Anahtarlar & Çevresel Değişkenler
.env
.env.*
*.key
*.pem
*.cer
*.crt
*.p8
*.p12
*.mobileprovision
*.keychain
*.token
*.secret

# Geçici & Yedek Dosyalar
*.tmp
*.temp
*.bak
*.swp
*~

# 2. Swift Package Manager & Xcode Derleme Kalıntıları
.build/
Packages/
Package.pins
Package.resolved
.swiftpm/
xcuserdata/
*.xcuserdatad
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcuserstate
UserInterfaceState.xcuserstate
build/
DerivedData/
*.moved-aside
*.xcresult
*.xccoverage

# 3. macOS Sistem Dosyaları
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db

# 4. Editörler & Geliştirme Araçları
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
.cursor/
.claude/

