# ==============================================================================
# easyRSS - .gitignore (Privacy & Security Focused)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kişisel Veriler, Akışlar & Gizlilik (Personal Data, Feeds & Privacy)
# ------------------------------------------------------------------------------
data.json
*.data
*.opml
*.xml
*.rss
*.atom
*.xml.backup
*.json.backup
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.store
*.store-shm
*.store-wal
*.log
*.crash
*.ips
logs/
private/
cache/
Cache/
caches/
Caches/

# ------------------------------------------------------------------------------
# 2. Kimlik Doğrulama, Sertifikalar, Anahtarlar & Çevresel Değişkenler
# ------------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.cer
*.crt
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
*.token
*.secret
*credentials*
*Credential*

# ------------------------------------------------------------------------------
# 3. Geçici, Yedek & Paketleme Dosyaları
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*~
*.dmg
*.pkg
*.app
*.ipa
*.zip
*.tar.gz
*.tgz

# ------------------------------------------------------------------------------
# 4. Xcode & Swift Package Manager Derleme ve Kullanıcı Verileri
# ------------------------------------------------------------------------------
.build/
build/
DerivedData/
Packages/
Package.pins
Package.resolved
.swiftpm/

# Xcode Kullanıcı Özelleştirmeleri (Kişisel pencere düzenleri, breakpoint'ler vb.)
xcuserdata/
*.xcuserdatad
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
UserInterfaceState.xcuserstate
*.moved-aside
*.xcresult
*.xccoverage
*.xcarchive
*.dSYM
*.dSYM.zip

# ------------------------------------------------------------------------------
# 5. macOS Sistem Dosyaları
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db

# ------------------------------------------------------------------------------
# 6. Editörler & Yapay Zeka / Geliştirme Araçları
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
.cursor/
.claude/
