# ==============================================================================
# easyRSS - .gitignore (Privacy, Security & Apple Developer Focused)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kişisel Veriler, Akışlar & Gizlilik (Personal Data, Feeds & Privacy)
# ------------------------------------------------------------------------------
data.json
*.data
*.opml
*.xml
*.rss
*.atom
*.xml.backup
*.json.backup
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.store
*.store-shm
*.store-wal
*.log
*.crash
*.ips
logs/
private/
cache/
Cache/
caches/
Caches/
Favicons/

# ------------------------------------------------------------------------------
# 2. Kimlik Doğrulama, Sertifikalar, Anahtarlar & Çevresel Değişkenler
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.cer
*.crt
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
*.token
*.secret
*credentials*
*Credential*

# ------------------------------------------------------------------------------
# 3. Geçici, Yedek, Test & Paketleme Dosyaları
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*~
*.orig
*.rej
*.patch
*.diff
*.dmg
*.pkg
*.app
*.ipa
*.zip
*.tar.gz
*.tgz
scratch/
test-results/
coverage/

# ------------------------------------------------------------------------------
# 4. Xcode, XcodeGen & Swift Package Manager Derleme Dosyaları
# ------------------------------------------------------------------------------
.build/
build/
DerivedData/
derivedData/
Packages/
Package.pins
Package.resolved
.swiftpm/
.xcodegen/
.xcodegen-cache/

# Xcode Kullanıcı Özelleştirmeleri (Kişisel pencere düzenleri, breakpoint'ler vb.)
xcuserdata/
*.xcuserdatad
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
UserInterfaceState.xcuserstate
*.moved-aside
*.xcresult
*.xccoverage
*.xccovreport
*.xcactivitylog
*.xcbkptlist
*.xcarchive
*.dSYM/
*.dSYM.zip
*.hmap

# ------------------------------------------------------------------------------
# 5. macOS & OS Sistem Dosyaları
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride

# ------------------------------------------------------------------------------
# 6. Editörler, Geliştirme Ortamları & Yapay Zeka Araçları
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
.cursor/
.claude/
.antigravity/
.windsurf/
.copilot/

# ------------------------------------------------------------------------------
# 7. Python & Yardımcı Betik Kalıntıları
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
